{
  "name": "vibeskilla-backend",
  "version": "3.0.0",
  "description": "Backend completo para VibesKilla Ecommerce con MongoDB - Arquitectura Modular",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "prod": "cross-env NODE_ENV=production node src/server.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "eslint . --ext .js",
    "format": "prettier --write \"src/**/*.js\"",
    "seed": "node src/scripts/seed.js"
  },
  "dependencies": {
    "@sendgrid/mail": "^8.1.6",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.0.1",
    "helmet": "^7.2.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "morgan": "^1.10.1",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.8",
    "ua-parser-js": "^2.0.6"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "eslint": "^8.55.0",
    "nodemon": "^3.0.1",
    "prettier": "^3.1.1"
  },
  "keywords": [
    "ecommerce",
    "backend",
    "api",
