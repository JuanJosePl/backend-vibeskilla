{
  "info": {
    "_postman_id": "a8f2d4b7-5c9d-4b21-bdf3-9c92c1f5d9a1",
    "name": "KillaVibes Admin API",
    "description": "Colección oficial Admin - Killa Vibes (Auth + Products)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://backend-vibeskilla.onrender.com/api"
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "productId",
      "value": "674b2c3d9f0e2b3c4d5e6f78"
    }
  ],
  "item": [
    {
      "name": "AUTH",
      "item": [
        {
          "name": "Admin Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"juanjose123@gmail.com\",\n  \"password\": \"12345679jjpl\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "ADMIN / PRODUCTS",
      "item": [
        {
          "name": "Get Admin Products",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/products",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "products"]
            }
          },
          "response": []
        },
        {
          "name": "Update Product (ADMIN)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 139.99,\n  \"stock\": 60,\n  \"isFeatured\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "products", "{{productId}}"]
            }
          },
          "response": []
        },
        {
          "name": "Delete Product (ADMIN)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "products", "{{productId}}"]
            }
          },
          "response": []
        }
      ]
    }
  ]
}
